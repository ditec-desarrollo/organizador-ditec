# Copiar a .env y completar. El .env no se sube al repo.

PORT = 4010

# Misma clave que usa el back de Ciudad Digital para firmar el token (cidituc-backend)
JWT_SECRET_KEY =

# Base del Organizador
HOST_ORGANIZADOR =
PORT_ORGANIZADOR = 3306
USER_ORGANIZADOR =
PASSWORD_ORGANIZADOR =
DB_ORGANIZADOR = organizador_smt

# Nombre de la base de Ciudad Digital (personas). Tiene que estar en el mismo servidor MySQL
# y el usuario de arriba necesita SELECT sobre su tabla persona.
DB_CIU_DIGITAL = ciudadano_digital

# Orígenes del front habilitados por CORS, separados por coma.
# Vacío = solo localhost (desarrollo).
CORS_ORIGENES = http://localhost:5173

# Días de anticipación para avisar que una tarea está por vencer
DIAS_AVISO_VENCIMIENTO = 2

# Días que una tarea finalizada sigue apareciendo en el tablero. Después solo se ve en el Historial.
DIAS_FINALIZADAS_EN_TABLERO = 7

# Solo producción: rutas de la clave y del certificado (con la cadena completa).
# Con las dos completas el back sirve HTTPS; vacías, sirve HTTP.
# HTTPS_KEY = /home/produccion/smt.gob.ar.key
# HTTPS_CERT = /home/produccion/smt.gob.ar.fullchain.crt
